<?xml version="1.0" encoding="UTF-8"?>
<!--
  OnlySay 日志配置（Spring Boot 加载，支持 springProperty 读取 application.yml）
  - 控制台：彩色输出，开发时看
  - 文件：落盘到 ${LOG_DIR}（默认当前工作目录 ./log），按日期滚动 + gzip 归档
  - 日志目录由 application.yml 的 onlysay.log.dir 控制，环境变量 ONLYSAY_LOG_DIR 可覆盖
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- 从 Spring 配置读取日志目录：onlysay.log.dir，缺省 ./log -->
    <springProperty name="LOG_DIR" source="onlysay.log.dir" defaultValue="./log"/>

    <!-- 应用名（用于日志文件命名） -->
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="onlysay"/>

    <!-- 控制台 Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%-28logger{28}) %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 全量日志文件 Appender：按天滚动，归档为 gzip -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- 当天日志固定写到这里 -->
        <file>${LOG_DIR}/${APP_NAME}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件：log/archived/2026-09-08/onlysay.0.log.gz（按日期分文件夹） -->
            <fileNamePattern>${LOG_DIR}/archived/%d{yyyy-MM-dd}/${APP_NAME}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志单独一份，方便排查 -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${APP_NAME}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archived/%d{yyyy-MM-dd}/${APP_NAME}-error.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 项目日志级别 -->
    <logger name="com.onlysay" level="INFO"/>

    <!-- 第三方框架降噪 -->
    <logger name="org.apache.hc" level="WARN"/>
    <logger name="ai.djl" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>

</configuration>
